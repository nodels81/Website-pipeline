# Abhängigkeiten
node_modules/
scripts/node_modules/

# Eingaben enthalten Kundendaten, Ausgaben sind Ergebnisse
eingang/*
!eingang/README.md
!eingang/VORLAGE-*.md
ausgang/*
!ausgang/.gitkeep

# Analyse-Ausgaben (Screenshots, Crawls, Lighthouse) – groß und projektbezogen
analyse/*
!analyse/.gitkeep

# Projekte enthalten Kundendaten und sind lokale Arbeitsstände (Sicherung: ausgang/<slug>.zip)
projekte/*
!projekte/.gitkeep

# Projekt-Builds und verdrängte Artefakte (falls projekte/ doch versioniert wird)
projekte/*/build/node_modules/
projekte/*/build/dist/
projekte/*/build/.astro/
projekte/*/build/.next/
projekte/*/artefakte/_alt/

# System
.DS_Store
*.log
.env
.env.*
